# 密钥模板。复制成 .env 后填真值：cp .env.example .env
#
# .env 已被 .gitignore 排除（项目根第 2、3 行），永远不要提交。
# 这里只放**占位**，不放任何真实值——这个文件是要进仓库的。
#
# 校验方式：`python code/agent/vault.py` 会打印每个键的来源、长度与掩码，
# 不齐会列出来。webapp / run.py 启动时也会先校验，缺了直接退出。

# 模型网关的 key（DeepSeek 或其他 OpenAI 兼容服务）。
# 这是全项目唯一真正"能花钱"的密钥，泄露即被盗刷。
LLM_API_KEY=

# Doris 只读账号。只读是硬边界：agent_ro 只有 SELECT_PRIV，
# 就算 SQL 被注入也写不进去。
DORIS_RO_PASSWORD=

# 项目自带 Redis 的密码。绑 127.0.0.1 时短密码可接受（vault 会提示"弱密钥"），
# 一旦改成对外监听就必须换强密码。
REDIS_PASSWORD=

# 可选：治理库连接串。本地 trust 认证时留空即可，代码会走默认值
# postgresql://postgres@127.0.0.1:55432/agent_gov
# GOV_PG_DSN=
